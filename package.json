{
  "name": "astrofrags",
  "version": "0.1.8",
  "description": "Astrofrags — local video import, ffmpeg audio/visual highlight detection, and clip/reel editing.",
  "main": "./out/main/index.js",
  "private": true,
  "scripts": {
    "dev": "electron-vite dev",
    "build": "electron-vite build",
    "web:prepare": "node scripts/copy-ffmpeg-core.mjs",
    "web:dev": "npm run web:prepare && vite --config web/vite.config.ts",
    "web:build": "npm run web:prepare && vite build --config web/vite.config.ts",
    "e2e": "playwright test",
    "test:coverage": "node --test --experimental-test-coverage web/src/lib/__tests__/*.test.ts",
    "test": "node --test src/main/__tests__/*.test.ts web/src/lib/__tests__/*.test.ts",
    "typecheck": "tsc --noEmit -p tsconfig.node.json && tsc --noEmit -p tsconfig.web.json && tsc --noEmit -p tsconfig.site.json",
    "dist": "electron-vite build && electron-builder --win --publish=never"
  },
  "dependencies": {
    "@xenova/transformers": "^2.17.2",
    "electron-updater": "^6.8.9",
    "ffmpeg-static": "^5.2.0",
    "fluent-ffmpeg": "^2.1.3",
    "tesseract.js": "^7.0.0",
    "wavesurfer.js": "^7.8.6"
  },
  "devDependencies": {
    "@ffmpeg/core": "0.12.10",
    "@ffmpeg/ffmpeg": "0.12.15",
    "@playwright/test": "1.64.1",
    "@types/fluent-ffmpeg": "^2.1.27",
    "@types/react": "^18.3.3",
    "@types/react-dom": "^18.3.0",
    "@vitejs/plugin-react": "^4.3.1",
    "electron": "^31.3.0",
    "electron-builder": "^26.15.3",
    "electron-vite": "^2.3.0",
    "react": "^18.3.1",
    "react-dom": "^18.3.1",
    "typescript": "^5.5.4",
    "vite": "^5.4.0"
  },
  "allowScripts": {
    "electron@31.7.7": true,
    "esbuild@0.21.5": true,
    "ffmpeg-static@5.3.0": true,
    "protobufjs@6.11.6": true,
    "sharp@0.32.6": true,
    "tesseract.js@7.0.0": true,
    "electron-winstaller@5.4.0": true
  },
  "build": {
    "appId": "com.astroy.astrofrags",
    "productName": "Astrofrags",
    "publish": {
      "provider": "github",
      "owner": "astroy-code",
      "repo": "astrofrags"
    },
    "directories": {
      "output": "dist"
    },
    "artifactName": "${productName}-Setup-${version}.${ext}",
    "files": [
      "out/**/*",
      "package.json",
      "assets/astrofrags-logo.png"
    ],
    "asarUnpack": [
      "**/node_modules/ffmpeg-static/**",
      "**/node_modules/sharp/**",
      "**/node_modules/onnxruntime-node/**",
      "**/node_modules/tesseract.js/**",
      "**/node_modules/tesseract.js-core/**",
      "assets/astrofrags-logo.png"
    ],
    "win": {
      "target": "nsis"
    },
    "nsis": {
      "oneClick": false,
      "allowToChangeInstallationDirectory": true
    }
  }
}
